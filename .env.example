# ============================================================
# Solana TX Stack — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Solana RPC ---
# Any Solana RPC works. Devnet for testing, mainnet for production.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
WALLET_KEYPAIR_PATH=./keypair.json

# --- Yellowstone gRPC (live slot streaming) ---
# Required for real-time slot tracking. Providers: Helius, Triton, QuickNode.
# If unavailable, the system falls back to RPC polling automatically.
YELLOWSTONE_ENDPOINT=https://your-yellowstone-endpoint
YELLOWSTONE_TOKEN=your-token-here

# --- Jito ---
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_AUTH_KEYPAIR_PATH=./keypair.json

# --- AI Agent Configuration ---
# Provider: anthropic | openai | gemini | grok
AI_PROVIDER=anthropic
AI_MODEL=claude-3-sonnet-20240229

# --- API Keys (only the one matching AI_PROVIDER is required) ---
CLAUDE_API_KEY=your-claude-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
GROK_API_KEY=your-grok-api-key

# --- Logging ---
LOG_FILE_PATH=./logs/lifecycle.json
